# SQLite-файл (путь относительно папки server/prisma)
DATABASE_URL="file:./dev.db"
PORT=3000
# Часовой пояс для «текущего месяца» (бот и веб по умолчанию)
APP_TIMEZONE=Asia/Tashkent

# Telegram-бот (необязательно: без токена бот не запускается, API работает)
TELEGRAM_BOT_TOKEN=
# Telegram ID пользователей, которым разрешён /pay, через запятую
ADMIN_IDS=
